{
  "manifest_version": 3,
  "name": "MyLoom Recorder",
  "version": "1.0.0",
  "description": "Record your screen and camera from any tab and send it straight to your own MyLoom.",
  "minimum_chrome_version": "116",
  "permissions": [
    "offscreen",
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "desktopCapture"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MyLoom \u2014 start a recording",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "128": "icons/icon-128.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png",
    "48": "icons/icon-48.png"
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Start or stop a MyLoom recording"
    }
  }
}